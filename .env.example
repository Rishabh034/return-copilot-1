# Required by the db container in docker-compose (compose-time interpolation).
# POSTGRES_PASSWORD is only read by postgres when initializing an empty data
# volume — it must match the password inside CLICKHELP_DATABASE_URL in AWS.
POSTGRES_USER=clickpost
POSTGRES_PASSWORD=
POSTGRES_DB=clickpost

# Comma-separated CORS origins (default in app/config.py if omitted)
ALLOWED_ORIGINS=https://alerts.clickpost.in

# Log shipping to S3: off by default (stdout only, fine for local dev).
# Set true on servers so logs survive container recreation:
# written to ./logs hourly, uploaded to S3 every 10 minutes.
LOG_TO_FILE=true

# RS256 JWT auth for agent requests (public key only -clickpost holds the
# private key and mints tokens via POST /api/v1/ai-agent/token/).
# false when doing local testing on prod its will be true.
AGENT_JWT_ENABLED=true
AGENT_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional — secondary Haiku model for tool-result scratchpad (defaults shown)
# RR_ANALYST_SECONDARY_MODEL=claude-haiku-4-5
# RR_ANALYST_SCRATCHPAD_ENABLED=true
# SCRATCHPAD_CHUNK_CHARS=12000
# SCRATCHPAD_INLINE_MAX_CHARS=80000
# TOOL_RESULT_QUERY_MAX_CHARS=8000

# Carrier onboarding README consumer (app/agenticintegrations/scripts/):
# loaded in app/agenticintegrations/utility/load_creds.py (PROD: AWS, else env).
AGENTIC_INTEGRATIONS_ANTHROPIC_API_KEY=
README_API_KEY=
ONBOARDING_SLACK_WEBHOOK_URL=
CLICKPOST_REPO_PATH=
