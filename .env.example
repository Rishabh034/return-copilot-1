# Required — the app will not start without it.
ANTHROPIC_API_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+asyncpg://<db user>:<db password>@db:5432/clickpost
# Optional — secondary Haiku model for tool-result scratchpad (defaults shown)
# RR_ANALYST_SECONDARY_MODEL=claude-haiku-4-5
# RR_ANALYST_SCRATCHPAD_ENABLED=true
# SCRATCHPAD_CHUNK_CHARS=12000
# SCRATCHPAD_INLINE_MAX_CHARS=80000
# TOOL_RESULT_QUERY_MAX_CHARS=8000
